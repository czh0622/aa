# 复制为 config.env 后按需修改：cp config.env.example config.env
# config.env 含密码，请勿提交到 Git

# Docker 容器名
CONTAINER_NAME=monitordb

# 容器内数据库端口（映射到宿主机 5435，脚本在容器内执行，用 5432）
DB_PORT=5432

# 目标数据库
DB_NAME=monitor

# 备份使用超级用户 omm（推荐，权限完整）
DB_USER=omm
DB_PASSWORD='GU1chuideng@2025'

# 若要用业务用户备份，可改为：
# DB_USER=monitor
# DB_PASSWORD='monitor_2012'

# 备份目录（宿主机绝对路径或相对路径）
BACKUP_DIR=./backups

# 备份文件保留天数（仅 cleanup 时生效）
KEEP_DAYS=7

# 备份格式：custom(推荐) | plain | directory
# custom: 压缩二进制，支持并行还原、选择性还原
# plain: 纯 SQL，可用文本编辑，体积较大
# directory: 目录格式，适合大库并行备份
BACKUP_FORMAT=custom

# 仅备份指定 schema（默认 public；留空表示整库）
SCHEMA=public

# 是否压缩 plain 格式输出（仅 BACKUP_FORMAT=plain 时有效）
COMPRESS_PLAIN=true
